From d2f8981d262e70093ecbb01b306a33f24cd44951 Mon Sep 17 00:00:00 2001
From: kk <kaiwalyakhasnis57@gmail.com>
Date: Wed, 14 Oct 2026 15:43:28 +0900
Subject: [PATCH 2/2] recovery: start Road Fighter right away when entered
 without a command

Exiting the game leads to the normal recovery menu. Recovery runs with
an update/wipe/sideload command are not affected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I4d739e245aa2f842218d962d351e53251b0cd5e0
---
 recovery.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/recovery.cpp b/recovery.cpp
index 3abbbd66..dfbdcb4e 100644
--- a/recovery.cpp
+++ b/recovery.cpp
@@ -1883,6 +1883,11 @@ int main(int argc, char **argv) {
     // 4. In all other cases, reboot the device. Therefore, normal users will observe the device
     //    reboot after it shows the "error" screen for 5s.
     if ((status == INSTALL_NONE && !sideload_auto_reboot) || ui->IsTextVisible()) {
+        // Recovery was entered without a command (no update/wipe/sideload): start Road Fighter
+        // right away. Exiting the game leads to the normal recovery menu.
+        if (status == INSTALL_NONE) {
+            run_road_fighter(ui);
+        }
         Device::BuiltinAction temp = prompt_and_wait(device, status);
         if (temp != Device::NO_ACTION) {
             after = temp;
