diff --git a/Android.mk b/Android.mk
index 43ec7d35..9e19444c 100644
--- a/Android.mk
+++ b/Android.mk
@@ -68,6 +68,10 @@ LOCAL_STATIC_LIBRARIES := \
 
 include $(BUILD_STATIC_LIBRARY)
 
+# Road Fighter assets (installed by roadfighter/Android.mk, required by recovery below)
+ROADFIGHTER_RES_FILES := road_left.png road_center.png road_right.png player_car.png blue_car.png
+ROADFIGHTER_RES_MODULES := $(addprefix roadfighter_,$(ROADFIGHTER_RES_FILES))
+
 # recovery (static executable)
 # ===============================
 include $(CLEAR_VARS)
@@ -83,7 +87,13 @@ LOCAL_SRC_FILES := \
     ui.cpp \
     vr_ui.cpp \
     wear_ui.cpp \
-    voldclient.cpp
+    voldclient.cpp \
+    roadfighter/roadfighter.cpp
+
+# Road Fighter draws into its own frame buffer, so it needs minui's pixel byte order.
+ifneq ($(filter ABGR_8888 BGRA_8888,$(subst ",,$(TARGET_RECOVERY_PIXEL_FORMAT))),)
+LOCAL_CFLAGS += -DROADFIGHTER_BGR
+endif
 
 # External tools
 LOCAL_SRC_FILES += \
@@ -302,7 +312,8 @@ LOCAL_REQUIRED_MODULES += \
     toybox_static \
     recovery_mkshrc \
     minivold \
-    bu_recovery
+    bu_recovery \
+    $(ROADFIGHTER_RES_MODULES)
 
 # Symlinks
 RECOVERY_TOOLS := \
@@ -484,6 +495,7 @@ include \
     $(LOCAL_PATH)/minui/Android.mk \
     $(LOCAL_PATH)/otafault/Android.mk \
     $(LOCAL_PATH)/otautil/Android.mk \
+    $(LOCAL_PATH)/roadfighter/Android.mk \
     $(LOCAL_PATH)/tests/Android.mk \
     $(LOCAL_PATH)/tools/Android.mk \
     $(LOCAL_PATH)/uncrypt/Android.mk \
