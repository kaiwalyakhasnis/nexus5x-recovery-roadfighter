--- /dev/null
+++ b/roadfighter/tools/vec2png.py
@@ -0,0 +1,45 @@
+"""Rasterize the game's pixel-art VectorDrawables (rectilinear M/L/Z paths) exactly, nonzero fill rule."""
+import re, sys, xml.etree.ElementTree as ET
+from PIL import Image
+A = '{http://schemas.android.com/apk/res/android}'
+
+def subpaths(d):
+    polys, cur = [], []
+    for cmd, args in re.findall(r'([MLZz])([^MLZz]*)', d):
+        nums = [float(n) for n in re.findall(r'-?[\d.]+', args)]
+        if cmd == 'M':
+            if cur: polys.append(cur)
+            cur = [tuple(nums[0:2])]
+            nums = nums[2:]
+        if cmd in 'ML':
+            cur += [tuple(nums[i:i+2]) for i in range(0, len(nums), 2)]
+        if cmd in 'Zz' and cur:
+            polys.append(cur); cur = []
+    if cur: polys.append(cur)
+    return polys
+
+def winding(polys, x, y):
+    w = 0
+    for p in polys:
+        for (x0, y0), (x1, y1) in zip(p, p[1:] + p[:1]):
+            if y0 <= y < y1 and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0): w += 1
+            elif y1 <= y < y0 and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0): w -= 1
+    return w
+
+src, dst, out_w, out_h = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
+v = ET.parse(src).getroot()
+vw, vh = float(v.get(A + 'viewportWidth')), float(v.get(A + 'viewportHeight'))
+paths = []
+for p in v.iter('path'):
+    c = p.get(A + 'fillColor').lstrip('#')
+    c = c[-6:]
+    paths.append(((int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16), 255), subpaths(p.get(A + 'pathData'))))
+img = Image.new('RGBA', (out_w, out_h), (0, 0, 0, 0))
+px = img.load()
+for j in range(out_h):
+    for i in range(out_w):
+        x, y = (i + 0.5) * vw / out_w, (j + 0.5) * vh / out_h
+        for color, polys in paths:
+            if winding(polys, x, y) != 0:
+                px[i, j] = color
+img.save(dst)
