+/*
+ * Road Fighter: a port of https://github.com/kaiwalyakhasnis/Road-Fighter-Compose to recovery.
+ *
+ * Game rules follow the Compose version:
+ *  - the road (left verge 1 : road 2.5 : right verge 0.5) and a blue car scroll down by one screen
+ *    height per cycle; the cycle time depends on the level,
+ *  - each Left/Right press moves the player car by 20dp,
+ *  - touching a verge or the blue car ends the game,
+ *  - every blue car that passes the player scores 1, and every 25 points is a new level (max 6),
+ *    which also speeds up the road and tints the verges.
+ *
+ * minui's gr_blit() is an unclipped opaque copy, so each frame is composed in a private RGBA buffer
+ * (clipping + alpha for the cars) and pushed with a single gr_blit() + gr_flip().
+ *
+ * Controls: Left/Right arrows, Volume Up/Down, or tap the left/right half of the screen.
+ * Game over: Power / Enter / tap plays again; Back / Esc (anytime) or a volume key exits.
+ */
+
+#include "roadfighter/roadfighter.h"
+
+#include <linux/input.h>
+#include <math.h>
+#include <png.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "minui/minui.h"
+#include "ui.h"
+
+namespace {
+
+const char* kResDir = "/etc/roadfighter/";
+
+// Phone width in dp (1080px at 420dpi); all game distances are in dp like the Compose version.
+const float kScreenWidthDp = 411.43f;
+const float kCarWidthDp = 23.197025f;
+const float kCarHeightDp = 32.0f;
+const float kPlayerStepDp = 20.0f;
+const float kPlayerBottomPaddingDp = 250.0f;
+const int kBlueCarMinDp = 120;
+const int kBlueCarMaxDp = 250;
+const float kButtonSizeDp = 75.0f;
+const float kButtonPadHDp = 10.0f;
+const float kButtonPadVDp = 100.0f;
+const float kDashPadDp = 20.0f;
+
+const int kMaxLevel = 6;
+const int kPointsPerLevel = 25;
+const int kLevelSpeedMs[kMaxLevel] = { 1500, 1400, 1300, 1200, 1000, 750 };
+// Verge tint per level (Compose ColorFilter.tint(color, BlendMode.Color)); alpha 0 = no tint.
+const uint32_t kLevelTint[kMaxLevel] = { 0x00000000, 0xFF0000FF, 0xFFEB6E65,
+                                         0x00000000, 0xFF0000FF, 0xFFEB6E65 };
+
+const int kFrameMs = 33;
+const int kGameOverInputDelayMs = 600;
+
+int64_t now_ms() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1000LL + ts.tv_nsec / 1000000;
+}
+
+// RGBA image, 4 bytes per pixel in R,G,B,A order.
+struct Image {
+  int w = 0;
+  int h = 0;
+  std::vector<uint8_t> px;
+
+  Image() {}
+  Image(int w_, int h_) : w(w_), h(h_), px(static_cast<size_t>(w_) * h_ * 4, 0) {}
+  uint8_t* at(int x, int y) { return &px[(static_cast<size_t>(y) * w + x) * 4]; }
+  const uint8_t* at(int x, int y) const { return &px[(static_cast<size_t>(y) * w + x) * 4]; }
+};
+
+bool load_png(const std::string& name, Image* out) {
+  std::string path = kResDir + name;
+  png_image png;
+  memset(&png, 0, sizeof(png));
+  png.version = PNG_IMAGE_VERSION;
+  if (!png_image_begin_read_from_file(&png, path.c_str())) {
+    printf("roadfighter: can't read %s: %s\n", path.c_str(), png.message);
+    return false;
+  }
+  png.format = PNG_FORMAT_RGBA;
+  *out = Image(png.width, png.height);
+  if (!png_image_finish_read(&png, nullptr, out->px.data(), 0, nullptr)) {
+    printf("roadfighter: can't decode %s: %s\n", path.c_str(), png.message);
+    png_image_free(&png);
+    return false;
+  }
+  return true;
+}
+
+Image scale_nearest(const Image& src, int w, int h) {
+  Image dst(std::max(w, 1), std::max(h, 1));
+  for (int y = 0; y < dst.h; ++y) {
+    int sy = y * src.h / dst.h;
+    for (int x = 0; x < dst.w; ++x) {
+      memcpy(dst.at(x, y), src.at(x * src.w / dst.w, sy), 4);
+    }
+  }
+  return dst;
+}
+
+// W3C "color" blend mode: hue and saturation of the tint, luminosity of the source.
+Image tint_color_blend(const Image& src, uint32_t argb) {
+  if ((argb >> 24) == 0) return src;
+  float tr = ((argb >> 16) & 0xff) / 255.0f, tg = ((argb >> 8) & 0xff) / 255.0f,
+        tb = (argb & 0xff) / 255.0f;
+  float tlum = 0.3f * tr + 0.59f * tg + 0.11f * tb;
+  Image dst = src;
+  for (size_t i = 0; i < dst.px.size(); i += 4) {
+    float lum = (0.3f * dst.px[i] + 0.59f * dst.px[i + 1] + 0.11f * dst.px[i + 2]) / 255.0f;
+    float d = lum - tlum;
+    float c[3] = { tr + d, tg + d, tb + d };
+    // ClipColor
+    float n = std::min({ c[0], c[1], c[2] }), x = std::max({ c[0], c[1], c[2] });
+    for (float& v : c) {
+      if (n < 0.0f) v = lum + (v - lum) * lum / (lum - n);
+      if (x > 1.0f) v = lum + (v - lum) * (1.0f - lum) / (x - lum);
+      dst.px[i + (&v - c)] = static_cast<uint8_t>(std::min(std::max(v, 0.0f), 1.0f) * 255.0f + 0.5f);
+    }
+  }
+  return dst;
+}
+
+bool point_in_polygon(const std::vector<float>& xy, float x, float y) {
+  bool in = false;
+  size_t n = xy.size() / 2;
+  for (size_t i = 0, j = n - 1; i < n; j = i++) {
+    float xi = xy[2 * i], yi = xy[2 * i + 1], xj = xy[2 * j], yj = xy[2 * j + 1];
+    if ((yi > y) != (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi) in = !in;
+  }
+  return in;
+}
+
+// Gray round button with a black chevron, like the Compose IconButton with
+// Icons.Default.KeyboardArrowLeft/Right.
+Image make_button(int size, float border, bool right) {
+  // Material "keyboard_arrow_left" path in a 24x24 viewport.
+  std::vector<float> chevron = { 15.41f, 16.59f, 10.83f, 12.0f, 15.41f, 7.41f,
+                                 14.0f,  6.0f,   8.0f,   12.0f, 14.0f,  18.0f };
+  if (right) {
+    for (size_t i = 0; i < chevron.size(); i += 2) chevron[i] = 24.0f - chevron[i];
+  }
+  Image img(size, size);
+  float r = size / 2.0f;
+  for (int y = 0; y < size; ++y) {
+    for (int x = 0; x < size; ++x) {
+      float cx = x + 0.5f - r, cy = y + 0.5f - r;
+      float dist = sqrtf(cx * cx + cy * cy);
+      if (dist > r) continue;
+      uint8_t* p = img.at(x, y);
+      bool black = dist > r - border ||
+                   point_in_polygon(chevron, (x + 0.5f) * 24.0f / size, (y + 0.5f) * 24.0f / size);
+      uint8_t v = black ? 0x00 : 0x88;
+      p[0] = p[1] = p[2] = v;
+      p[3] = 0xff;
+    }
+  }
+  return img;
+}
+
+struct RectF {
+  float left, top, right, bottom;
+  // Same as Compose Rect.overlaps().
+  bool overlaps(const RectF& o) const {
+    return !(right <= o.left || o.right <= left || bottom <= o.top || o.bottom <= top);
+  }
+};
+
+class Game {
+ public:
+  explicit Game(RecoveryUI* ui) : ui_(ui) {}
+
+  bool Init();
+  void Run();
+
+ private:
+  enum class Status { RUNNING, FINISHED };
+  enum class Input { NONE, LEFT, RIGHT, RESTART, EXIT };
+
+  float dp(float v) const { return v * density_; }
+  int level_index() const { return std::min(std::max(level_, 1), kMaxLevel) - 1; }
+
+  void Reset();
+  void Update(int64_t dt_ms);
+  Input Translate(const RecoveryUI::InputEvent& ev) const;
+  void Render();
+  void Present();
+
+  void Blit(const Image& img, int dx, int dy, bool opaque);
+
+  RecoveryUI* ui_;
+  int width_ = 0;
+  int height_ = 0;
+  float density_ = 1.0f;
+
+  Image road_[3][kMaxLevel];  // [left, center, right][level], pre-scaled and pre-tinted
+  int road_x_[3] = {};
+  Image player_car_;
+  Image blue_car_;
+  Image button_left_;
+  Image button_right_;
+
+  Image frame_;
+  GRSurface surface_ = {};
+
+  Status status_ = Status::RUNNING;
+  int64_t finished_at_ms_ = 0;
+  int score_ = 0;
+  int level_ = 1;
+  float player_offset_dp_ = 0.0f;
+  float anim_ = 0.0f;  // 0..1 progress of the road/blue car through one screen height
+  float blue_x_ = 0.0f;
+  float blue_target_x_ = 0.0f;
+  bool blue_counted_ = false;
+};
+
+bool Game::Init() {
+  width_ = gr_fb_width();
+  height_ = gr_fb_height();
+  density_ = width_ / kScreenWidthDp;
+
+  Image road_src[3], player, blue;
+  if (!load_png("road_left.png", &road_src[0]) || !load_png("road_center.png", &road_src[1]) ||
+      !load_png("road_right.png", &road_src[2]) || !load_png("player_car.png", &player) ||
+      !load_png("blue_car.png", &blue)) {
+    return false;
+  }
+
+  // Row weights 1 : 2.5 : 0.5, each section stretched to the full screen height.
+  int edges[4] = { 0, width_ / 4, width_ * 7 / 8, width_ };
+  for (int s = 0; s < 3; ++s) {
+    road_x_[s] = edges[s];
+    // Row 0 of the road PNGs is a dark line (the Compose version hides it by overlapping the two
+    // copies by 2dp); drop it so the road tiles seamlessly.
+    Image& src = road_src[s];
+    if (src.h > 1) {
+      src.px.erase(src.px.begin(), src.px.begin() + src.w * 4);
+      --src.h;
+    }
+    Image scaled = scale_nearest(src, edges[s + 1] - edges[s], height_);
+    for (int l = 0; l < kMaxLevel; ++l) {
+      // The Compose version only tints the verges.
+      road_[s][l] = (s == 1) ? scaled : tint_color_blend(scaled, kLevelTint[l]);
+    }
+  }
+
+  int car_w = static_cast<int>(dp(kCarWidthDp) + 0.5f);
+  int car_h = static_cast<int>(dp(kCarHeightDp) + 0.5f);
+  player_car_ = scale_nearest(player, car_w, car_h);
+  blue_car_ = scale_nearest(blue, car_w, car_h);
+
+  int button = static_cast<int>(dp(kButtonSizeDp));
+  button_left_ = make_button(button, std::max(dp(1.0f), 1.0f), false);
+  button_right_ = make_button(button, std::max(dp(1.0f), 1.0f), true);
+
+  frame_ = Image(width_, height_);
+  surface_.width = width_;
+  surface_.height = height_;
+  surface_.row_bytes = width_ * 4;
+  surface_.pixel_bytes = 4;
+  surface_.data = frame_.px.data();
+  return true;
+}
+
+void Game::Reset() {
+  status_ = Status::RUNNING;
+  score_ = 0;
+  level_ = 1;
+  player_offset_dp_ = 0.0f;
+  anim_ = 0.0f;
+  blue_target_x_ = dp(kBlueCarMinDp + rand() % (kBlueCarMaxDp - kBlueCarMinDp + 1));
+  blue_x_ = blue_target_x_;
+  blue_counted_ = false;
+}
+
+void Game::Update(int64_t dt_ms) {
+  anim_ += static_cast<float>(dt_ms) / kLevelSpeedMs[level_index()];
+  if (anim_ >= 1.0f) {
+    anim_ = fmodf(anim_, 1.0f);
+    blue_target_x_ = dp(kBlueCarMinDp + rand() % (kBlueCarMaxDp - kBlueCarMinDp + 1));
+  }
+  // animateDpAsState's spring, approximated with an exponential approach.
+  blue_x_ += (blue_target_x_ - blue_x_) * (1.0f - expf(-dt_ms / 80.0f));
+
+  RectF blue = { blue_x_, height_ * anim_, blue_x_ + blue_car_.w, height_ * anim_ + blue_car_.h };
+  float px = (width_ - player_car_.w) / 2.0f + dp(player_offset_dp_);
+  float py = height_ - dp(kPlayerBottomPaddingDp) - player_car_.h;
+  RectF player = { px, py, px + player_car_.w, py + player_car_.h };
+  RectF left_verge = { 0.0f, 0.0f, static_cast<float>(road_x_[1]), static_cast<float>(height_) };
+  RectF right_verge = { static_cast<float>(road_x_[2]), 0.0f, static_cast<float>(width_),
+                        static_cast<float>(height_) };
+
+  if (player.overlaps(left_verge) || player.overlaps(right_verge) || player.overlaps(blue)) {
+    status_ = Status::FINISHED;
+    finished_at_ms_ = now_ms();
+    return;
+  }
+
+  if (!blue_counted_ && blue.top >= player.top) {
+    blue_counted_ = true;
+    ++score_;
+    if (score_ % kPointsPerLevel == 0 && level_ < kMaxLevel) ++level_;
+  } else if (blue.top < player.top) {
+    blue_counted_ = false;
+  }
+}
+
+Game::Input Game::Translate(const RecoveryUI::InputEvent& ev) const {
+  if (ev.type() == RecoveryUI::EVENT_TYPE_TOUCH) {
+    if (status_ == Status::FINISHED) return Input::RESTART;
+    return ev.pos().x() < width_ / 2 ? Input::LEFT : Input::RIGHT;
+  }
+  if (ev.type() != RecoveryUI::EVENT_TYPE_KEY) return Input::NONE;
+
+  switch (ev.key()) {
+    case KEY_BACK:
+    case KEY_ESC:
+    case KEY_BACKSPACE:
+      return Input::EXIT;
+    case KEY_LEFT:
+      return status_ == Status::RUNNING ? Input::LEFT : Input::NONE;
+    case KEY_RIGHT:
+      return status_ == Status::RUNNING ? Input::RIGHT : Input::NONE;
+    // Phones without a back key exit with a volume key from the game over screen.
+    case KEY_VOLUMEUP:
+      return status_ == Status::RUNNING ? Input::LEFT : Input::EXIT;
+    case KEY_VOLUMEDOWN:
+      return status_ == Status::RUNNING ? Input::RIGHT : Input::EXIT;
+    case KEY_POWER:
+    case KEY_ENTER:
+    case KEY_KPENTER:
+    case KEY_SPACE:
+      return status_ == Status::FINISHED ? Input::RESTART : Input::NONE;
+    default:
+      return Input::NONE;
+  }
+}
+
+void Game::Blit(const Image& img, int dx, int dy, bool opaque) {
+  int x0 = std::max(dx, 0), y0 = std::max(dy, 0);
+  int x1 = std::min(dx + img.w, width_), y1 = std::min(dy + img.h, height_);
+  if (x0 >= x1 || y0 >= y1) return;
+  for (int y = y0; y < y1; ++y) {
+    const uint8_t* s = img.at(x0 - dx, y - dy);
+    uint8_t* d = frame_.at(x0, y);
+    if (opaque) {
+      memcpy(d, s, (x1 - x0) * 4);
+      continue;
+    }
+    for (int x = x0; x < x1; ++x, s += 4, d += 4) {
+      unsigned a = s[3];
+      if (a == 255) {
+        memcpy(d, s, 4);
+      } else if (a != 0) {
+        for (int c = 0; c < 3; ++c) d[c] = (s[c] * a + d[c] * (255 - a)) / 255;
+      }
+    }
+  }
+}
+
+void Game::Render() {
+  if (status_ == Status::FINISHED) {
+    gr_color(0, 0, 0, 255);
+    gr_clear();
+    const GRFont* font = gr_menu_font();
+    int cw, ch;
+    gr_font_size(font, &cw, &ch);
+    std::vector<std::string> lines = { "Game Over",
+                                       "Score " + std::to_string(score_),
+                                       "",
+                                       "",
+                                       "Tap / Power / Enter",
+                                       "to play again",
+                                       "",
+                                       "Back / Esc / Volume",
+                                       "to exit" };
+    int y = (height_ - static_cast<int>(lines.size()) * ch * 3 / 2) / 2;
+    gr_color(255, 255, 255, 255);
+    for (const auto& line : lines) {
+      if (!line.empty()) gr_text(font, (width_ - gr_measure(font, line.c_str())) / 2, y, line.c_str(), false);
+      y += ch * 3 / 2;
+    }
+    gr_flip();
+    return;
+  }
+
+  int road_y = static_cast<int>(height_ * anim_);
+  for (int s = 0; s < 3; ++s) {
+    const Image& section = road_[s][level_index()];
+    Blit(section, road_x_[s], road_y, true);
+    Blit(section, road_x_[s], road_y - height_, true);
+  }
+  Blit(blue_car_, static_cast<int>(blue_x_), road_y, false);
+  Blit(player_car_,
+       static_cast<int>((width_ - player_car_.w) / 2.0f + dp(player_offset_dp_)),
+       static_cast<int>(height_ - dp(kPlayerBottomPaddingDp) - player_car_.h), false);
+  int button_y = static_cast<int>(height_ - dp(kButtonPadVDp)) - button_left_.h;
+  Blit(button_left_, static_cast<int>(dp(kButtonPadHDp)), button_y, false);
+  Blit(button_right_, width_ - static_cast<int>(dp(kButtonPadHDp)) - button_right_.w, button_y,
+       false);
+  Present();
+
+  // Dashboard: black box at the top left with score and level.
+  const GRFont* font = gr_menu_font();
+  int cw, ch;
+  gr_font_size(font, &cw, &ch);
+  std::string lines[4] = { "Score", std::to_string(score_), "Level", std::to_string(level_) };
+  int text_w = 0;
+  for (const auto& l : lines) text_w = std::max(text_w, gr_measure(font, l.c_str()));
+  int pad = static_cast<int>(dp(kDashPadDp));
+  gr_color(0, 0, 0, 255);
+  gr_fill(0, 0, text_w + 2 * pad, 4 * ch + ch / 2);
+  gr_color(255, 255, 255, 255);
+  for (int i = 0; i < 4; ++i) gr_text(font, pad, ch / 4 + i * ch, lines[i].c_str(), false);
+  gr_flip();
+}
+
+void Game::Present() {
+#ifdef ROADFIGHTER_BGR
+  for (size_t i = 0; i < frame_.px.size(); i += 4) std::swap(frame_.px[i], frame_.px[i + 2]);
+#endif
+  gr_blit(&surface_, 0, 0, width_, height_, 0, 0);
+}
+
+void Game::Run() {
+  Reset();
+  int64_t last = now_ms();
+  while (true) {
+    int64_t frame_start = now_ms();
+    int64_t dt = std::min<int64_t>(frame_start - last, 100);
+    last = frame_start;
+    if (status_ == Status::RUNNING) Update(dt);
+    Render();
+
+    // Handle input until it's time for the next frame.
+    int64_t deadline = frame_start + kFrameMs;
+    RecoveryUI::InputEvent ev;
+    while (ui_->PollInputEvent(&ev, static_cast<int>(std::max<int64_t>(deadline - now_ms(), 0)))) {
+      Input in = Translate(ev);
+      if (status_ == Status::FINISHED && in != Input::NONE &&
+          now_ms() - finished_at_ms_ < kGameOverInputDelayMs) {
+        continue;  // ignore presses that were meant for steering when the crash happened
+      }
+      switch (in) {
+        case Input::LEFT:
+          player_offset_dp_ -= kPlayerStepDp;
+          break;
+        case Input::RIGHT:
+          player_offset_dp_ += kPlayerStepDp;
+          break;
+        case Input::RESTART:
+          Reset();
+          last = now_ms();
+          break;
+        case Input::EXIT:
+          return;
+        case Input::NONE:
+          break;
+      }
+    }
+  }
+}
+
+}  // namespace
+
+void run_road_fighter(RecoveryUI* ui) {
+  srand(static_cast<unsigned>(now_ms()));
+  Game game(ui);
+  if (!game.Init()) {
+    ui->Print("Road Fighter: couldn't load the game images from %s\n", kResDir);
+    return;
+  }
+  ui->SetBackground(RecoveryUI::NONE);
+  ui->SetProgressType(RecoveryUI::EMPTY);
+  ui->FlushKeys();
+  game.Run();
+  ui->FlushKeys();
+}
