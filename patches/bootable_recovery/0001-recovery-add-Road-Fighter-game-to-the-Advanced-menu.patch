+bool RecoveryUI::PollInputEvent(InputEvent* event, int timeout_ms) {
+  pthread_mutex_lock(&event_queue_mutex);
+
+  if (event_queue_len == 0 && timeout_ms > 0) {
+    struct timeval now;
+    struct timespec timeout;
+    gettimeofday(&now, nullptr);
+    long long nsec = now.tv_usec * 1000LL + timeout_ms * 1000000LL;
+    timeout.tv_sec = now.tv_sec + nsec / 1000000000LL;
+    timeout.tv_nsec = nsec % 1000000000LL;
+
+    int rc = 0;
+    while (event_queue_len == 0 && rc != ETIMEDOUT) {
+      rc = pthread_cond_timedwait(&event_queue_cond, &event_queue_mutex, &timeout);
+    }
+  }
+
+  bool got = event_queue_len > 0;
+  if (got) {
+    *event = event_queue[0];
+    memcpy(&event_queue[0], &event_queue[1], sizeof(event_queue[0]) * --event_queue_len);
+  }
+  pthread_mutex_unlock(&event_queue_mutex);
+  return got;
+}
