   typedef std::vector<MenuItem> MenuItemVector;
diff --git a/recovery.cpp b/recovery.cpp
index df92a0d5..3abbbd66 100644
--- a/recovery.cpp
+++ b/recovery.cpp
@@ -67,6 +67,7 @@
 #include "minadbd/minadbd.h"
 #include "minui/minui.h"
 #include "otautil/DirUtil.h"
+#include "roadfighter/roadfighter.h"
 #include "roots.h"
 #include "rotate_logs.h"
 #include "screen_ui.h"
@@ -1359,6 +1360,10 @@ static Device::BuiltinAction prompt_and_wait(Device* device, int status) {
         run_graphics_test();
         break;
 
+      case Device::ROAD_FIGHTER:
+        run_road_fighter(ui);
+        break;
+
       case Device::MOUNT_SYSTEM:
         // For a system image built with the root directory (i.e. system_root_image == "true"), we
         // mount it to /system_root, and symlink /system to /system_root/system to make adb shell
diff --git a/roadfighter/Android.mk b/roadfighter/Android.mk
new file mode 100644
index 00000000..fe780b2b
--- /dev/null
+++ b/roadfighter/Android.mk
@@ -0,0 +1,18 @@
+# Road Fighter game assets, installed into the recovery ramdisk at /etc/roadfighter
+# (not /res: the recovery image build wipes res/* and recopies the stock resources).
+# The game code itself (roadfighter.cpp) is built into the recovery executable.
+
+LOCAL_PATH := $(call my-dir)
+
+define roadfighter-res
+include $$(CLEAR_VARS)
+LOCAL_MODULE := roadfighter_$(1)
+LOCAL_MODULE_STEM := $(1)
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_PATH := $$(TARGET_RECOVERY_ROOT_OUT)/etc/roadfighter
+LOCAL_SRC_FILES := res/$(1)
+include $$(BUILD_PREBUILT)
+endef
+
+$(foreach f,$(ROADFIGHTER_RES_FILES),$(eval $(call roadfighter-res,$(f))))
