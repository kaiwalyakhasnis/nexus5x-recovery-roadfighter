# Applied on top of lineageos_bullhead_defconfig for the QEMU kernel (setup.sh uses scripts/config).
# Console: PL011 for early boot log (earlyprintk), virtio console (hvc0) for the busybox shell.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y
# virtio over QEMU virt's MMIO transports
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
# virtio keyboard/mouse/tablet (patch 0004)
CONFIG_VIRTIO_INPUT=y
# RAM framebuffer for recovery's screen (patches 0002/0003)
CONFIG_FB_SIMPLE=y
# /dev for the busybox initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Qualcomm register trace buffer: needs memory QEMU doesn't have
# CONFIG_MSM_RTB is not set
